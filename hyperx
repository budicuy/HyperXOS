#!/bin/sh
# HyperXOS Project Self-Bootstrapping CLI Runner
# Automatically builds and executes the Pure Rust 'hyperx' developer toolchain.
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BIN="$SCRIPT_DIR/rust/hyperx-cli/target/release/hyperx"

SRC_DIR="$SCRIPT_DIR/rust/hyperx-cli/src"

if [ ! -x "$BIN" ] || [ -n "$(find "$SRC_DIR" -type f -newer "$BIN" 2>/dev/null)" ]; then
    echo "==> [HyperXOS] Mengompilasi/memperbarui toolchain CLI 'hyperx'..."
    cargo build --release --manifest-path "$SCRIPT_DIR/rust/hyperx-cli/Cargo.toml"
fi

exec "$BIN" "$@"
