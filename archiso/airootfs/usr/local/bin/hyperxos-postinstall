#!/usr/bin/env bash
# HyperXOS Post-Installation & Graphical Environment Setup Engine
set -euo pipefail

log() {
    echo "==> [HyperXOS-PostInstall] $*"
}

log "Starting post-installation configuration..."

# 1. SDDM Wayland Greeter Configuration
log "Configuring SDDM Wayland greeter compositor (KWin Wayland)..."
mkdir -p /etc/sddm.conf.d

cat << 'EOF' > /etc/sddm.conf.d/10-wayland.conf
[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Wayland]
CompositorCommand=kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1
EOF

# Ensure /etc/sddm.conf exists and has General Wayland set if not already defined
if [ ! -f /etc/sddm.conf ]; then
    cat << 'EOF' > /etc/sddm.conf
[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell
EOF
fi

# 2. Set default systemd target to graphical.target
log "Setting default systemd boot target to graphical.target..."
systemctl set-default graphical.target || true

# 3. Enable Display Manager (SDDM / GDM)
log "Enabling display manager service..."
if [ -f /usr/bin/sddm ]; then
    systemctl enable sddm.service || true
    log "SDDM service enabled."
elif [ -f /usr/bin/gdm ]; then
    systemctl enable gdm.service || true
    log "GDM service enabled."
fi

# 4. Enable essential system services (NetworkManager, resolved, timesyncd)
log "Enabling network and system services..."
for srv in NetworkManager systemd-resolved systemd-timesyncd bluetooth; do
    if systemctl list-unit-files "${srv}.service" &>/dev/null; then
        systemctl enable "${srv}.service" || true
        log "Enabled ${srv}.service"
    fi
done

# 5. Fix DNS Resolution & Ensure Reliable Nameservers
log "Configuring DNS resolution and removing broken symlinks..."
rm -f /etc/resolv.conf
cat << 'EOF' > /etc/resolv.conf
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 1.0.0.1
EOF
chmod 644 /etc/resolv.conf

# 6. Sudoers Configuration for Wheel Group
log "Ensuring sudoers permissions for administrative users..."
mkdir -p /etc/sudoers.d
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# 7. Initialize Clean Pacman Keyring on Target System
log "Initializing clean pacman keyring and database on target system..."
rm -f /var/lib/pacman/db.lck /etc/pacman.d/gnupg/*.lock /etc/pacman.d/gnupg/S.* 2>/dev/null || true
pacman-key --init || true
pacman-key --populate archlinux cachyos hyperxos || true

# Refresh local pacman databases in target system
log "Syncing pacman repository databases..."
pacman -Sy || true

# 8. Clean up installer shortcuts and setup user desktop icons
log "Configuring desktop shortcuts and cleaning up live installer icons..."
find /home -name 'calamares.desktop' -type f -delete 2>/dev/null || true
find /home -name 'hyper-x-installer.desktop' -type f -delete 2>/dev/null || true

# Place HyperXTools desktop icon on user desktops
for user_home in /home/*; do
    if [ -d "${user_home}" ] && [ "$(basename "${user_home}")" != "hyperxos" ]; then
        user_name=$(basename "${user_home}")
        desktop_dir="${user_home}/Desktop"
        mkdir -p "${desktop_dir}"
        for app_desktop in /usr/share/applications/hyper-x-tools.desktop /usr/share/applications/hyperxtools.desktop; do
            if [ -f "${app_desktop}" ]; then
                cp -f "${app_desktop}" "${desktop_dir}/hyper-x-tools.desktop"
                chmod 755 "${desktop_dir}/hyper-x-tools.desktop" 2>/dev/null || true
                chown -R "${user_name}:${user_name}" "${desktop_dir}" 2>/dev/null || true
                break
            fi
        done
    fi
done

log "Post-installation environment setup completed successfully."
exit 0
