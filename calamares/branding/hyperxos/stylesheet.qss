/* HyperXOS Calamares Dark Theme Stylesheet */

QWidget {
    font-size: 13px;
    color: #e6edf3;
    background-color: #0d1117;
}

#mainApp {
    background-color: #0d1117;
    color: #e6edf3;
}

#sidebarApp {
    background-color: #161b22;
    min-width: 190px;
}

QTabWidget::pane {
    border: none;
    background-color: #0d1117;
}

QProgressBar {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 4px;
    height: 18px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #238636;
    border-radius: 3px;
}

QPlainTextEdit {
    background-color: #0d1117;
    color: #58a6ff;
    font-family: "JetBrains Mono", "Hack", monospace;
    font-size: 11px;
    border: 1px solid #30363d;
    border-radius: 4px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton#debugButton {
    background-color: transparent;
    border: none;
    color: #8b949e;
    font-size: 10px;
}
