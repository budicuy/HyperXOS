import { Theme } from "../theme.slint";

export component MetricCard inherits Rectangle {
    in property <string> title: "Hardware";
    in property <string> icon: "⚡";
    in property <string> value: "0%";
    in property <float> progress: 0.0; // 0.0 to 1.0
    in property <string> subtext: "-";
    in property <string> extratext: "";
    in property <color> accent-color: Theme.accent;

    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Card Header
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.icon;
                    font-size: 16px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-main;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.value;
                font-size: 18px;
                font-weight: 700;
                color: root.accent-color;
                vertical-alignment: center;
            }
        }

        // Sleek Minimalist Progress Bar
        Rectangle {
            height: 8px;
            background: Theme.bg-sidebar;
            border-radius: 4px;

            // Fill bar
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * Math.min(1.0, Math.max(0.0, root.progress));
                background: root.accent-color;
                border-radius: 4px;

                animate width {
                    duration: 250ms;
                    easing: ease-out;
                }
            }
        }

        // Subtitle & Extra Info
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.subtext;
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
            }
            if root.extratext != "": Text {
                text: root.extratext;
                font-size: 11px;
                font-weight: 600;
                color: Theme.accent-purple;
            }
        }
    }
}
