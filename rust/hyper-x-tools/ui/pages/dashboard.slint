import { Theme } from "../theme.slint";
import { MetricCard } from "../components/metric_card.slint";

export component DashboardPage inherits Flickable {
    // Hardware Metrics Properties
    in property <string> cpu-usage-text: "0.0%";
    in property <float> cpu-progress: 0.0;
    in property <string> cpu-subtext: "Memuat Core CPU...";
    in property <string> cpu-extratext: "";

    in property <string> ram-usage-text: "0.0%";
    in property <float> ram-progress: 0.0;
    in property <string> ram-subtext: "Terpakai: 0 GB / 0 GB";
    in property <string> ram-extratext: "";

    in property <string> disk-usage-text: "0.0%";
    in property <float> disk-progress: 0.0;
    in property <string> disk-subtext: "Terpakai: 0 GB / 0 GB";
    in property <string> disk-extratext: "";

    in property <string> gpu-usage-text: "0.0%";
    in property <float> gpu-progress: 0.0;
    in property <string> gpu-subtext: "Mendeteksi GPU...";
    in property <string> gpu-extratext: "";

    // System Info
    in property <string> os-name: "HyperXOS Linux 2026.10";
    in property <string> kernel-ver: "Memuat...";
    in property <string> uptime-str: "0j 0m";
    in property <string> session-type: "Wayland / X11";

    callback refresh-clicked();
    callback quick-clean-clicked();
    callback quick-gametweaks-clicked();
    callback quick-kernel-clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // Title and Header
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "📊 Dashboard & Monitoring Hardware";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-main;
                }
                Text {
                    text: "Pemantauan sumber daya perangkat keras dan status sistem real-time.";
                    font-size: 12px;
                    color: Theme.text-sub;
                }
            }

            // Quick Refresh Button
            Rectangle {
                height: 32px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    Text {
                        text: "🔄 Segarkan";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.refresh-clicked(); }
                    mouse-cursor: pointer;
                }
            }
        }

        // 2x2 Metric Cards Grid
        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 16px;
                MetricCard {
                    title: "Prosesor (CPU)";
                    icon: "⚡";
                    value: root.cpu-usage-text;
                    progress: root.cpu-progress;
                    subtext: root.cpu-subtext;
                    extratext: root.cpu-extratext;
                    accent-color: Theme.accent;
                }
                MetricCard {
                    title: "Memori (RAM & Swap)";
                    icon: "🧠";
                    value: root.ram-usage-text;
                    progress: root.ram-progress;
                    subtext: root.ram-subtext;
                    extratext: root.ram-extratext;
                    accent-color: Theme.accent-purple;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                MetricCard {
                    title: "Penyimpanan Disk (Root /)";
                    icon: "💾";
                    value: root.disk-usage-text;
                    progress: root.disk-progress;
                    subtext: root.disk-subtext;
                    extratext: root.disk-extratext;
                    accent-color: Theme.accent-teal;
                }
                MetricCard {
                    title: "Akselerasi Grafis (GPU)";
                    icon: "🎮";
                    value: root.gpu-usage-text;
                    progress: root.gpu-progress;
                    subtext: root.gpu-subtext;
                    extratext: root.gpu-extratext;
                    accent-color: Theme.success;
                }
            }
        }

        // System Information Card
        Rectangle {
            background: Theme.bg-card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "ℹ️ Informasi Sistem";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }

                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Distribusi OS:"; font-size: 11px; color: Theme.text-muted; }
                        Text { text: root.os-name; font-size: 13px; font-weight: 600; color: Theme.text-main; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Kernel Aktif:"; font-size: 11px; color: Theme.text-muted; }
                        Text { text: root.kernel-ver; font-size: 13px; font-weight: 600; color: Theme.success; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Sesi Layar:"; font-size: 11px; color: Theme.text-muted; }
                        Text { text: root.session-type; font-size: 13px; font-weight: 600; color: Theme.text-main; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Waktu Aktif (Uptime):"; font-size: 11px; color: Theme.text-muted; }
                        Text { text: root.uptime-str; font-size: 13px; font-weight: 600; color: Theme.text-main; }
                    }
                }
            }
        }

        // Quick Action Buttons
        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                height: 38px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "🧹 Bersihkan Cache Sistem";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.quick-clean-clicked(); }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 38px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "🚀 Buka Tweak Gaming";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.quick-gametweaks-clicked(); }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 38px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "🐧 Kelola Kernel CachyOS";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.quick-kernel-clicked(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
