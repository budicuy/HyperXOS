import { Theme } from "../theme.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { TerminalBox } from "../components/terminal_box.slint";

export struct StoreItem {
    package_name: string,
    display_name: string,
    category: string,
    description: string,
    installed: bool,
}

export component PackageStorePage inherits Flickable {
    in-out property <string> search-query: "";
    in property <string> active-category: "Semua";
    in property <[StoreItem]> store-items: [];
    in property <string> terminal-log: "Siap.";

    callback set-category(string);
    callback search-changed(string);
    callback install-package(string);
    callback remove-package(string);
    callback clear-log();

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // Header
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "🛍️ HyperX Software Store";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-main;
            }
            Text {
                text: "Pemasangan aplikasi kurasi HyperXOS untuk kebutuhan harian, produktivitas, dan gaming.";
                font-size: 12px;
                color: Theme.text-sub;
            }
        }

        // Search Bar & Categories
        VerticalLayout {
            spacing: 10px;

            // Search Box
            Rectangle {
                height: 38px;
                background: Theme.bg-input;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "🔍";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    TextInput {
                        text <=> root.search-query;
                        font-size: 12px;
                        color: Theme.text-main;
                        vertical-alignment: center;
                        edited => { root.search-changed(root.search-query); }
                    }
                }
            }

            // Categories Filter Buttons
            HorizontalLayout {
                spacing: 8px;

                for cat[idx] in ["Semua", "Browsers", "Gaming", "Development", "Multimedia", "Utilities"]: Rectangle {
                    height: 28px;
                    background: root.active-category == cat ? Theme.accent : Theme.bg-card;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: cat;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.active-category == cat ? Theme.text-dark : Theme.text-main;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.set-category(cat); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }

        // Package Grid / List
        VerticalLayout {
            spacing: 10px;

            for item[idx] in root.store-items: Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: item.display_name;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-main;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "(" + item.package_name + ")";
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            StatusBadge {
                                text: item.installed ? "Terpasang" : "Belum Terpasang";
                                active: item.installed;
                                is-running: item.installed;
                            }
                        }
                        Text {
                            text: item.description;
                            font-size: 11px;
                            color: Theme.text-sub;
                        }
                    }

                    // Install / Remove action
                    HorizontalLayout {
                        alignment: center;

                        if !item.installed: Rectangle {
                            height: 30px;
                            background: Theme.accent.with-alpha(0.15);
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: "Pasang";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.install-package(item.package_name); }
                                mouse-cursor: pointer;
                            }
                        }

                        if item.installed: Rectangle {
                            height: 30px;
                            background: Theme.danger.with-alpha(0.15);
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.danger;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: "Copot";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.danger;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.remove-package(item.package_name); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }

        // Terminal Log Console
        TerminalBox {
            log-text: root.terminal-log;
            clear-clicked => { root.clear-log(); }
        }
    }
}
