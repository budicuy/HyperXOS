import { Theme } from "../theme.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { TerminalBox } from "../components/terminal_box.slint";

export component GameTweaksPage inherits Flickable {
    in property <string> current-governor: "powersave";
    in property <string> max-map-count-value: "65530";
    in property <bool> is-max-map-optimized: false;
    in property <bool> is-split-lock-disabled: false;
    in property <bool> is-gamemode-active: false;
    in property <string> terminal-log: "Siap.";

    callback set-governor(string);
    callback toggle-max-map-count();
    callback toggle-split-lock();
    callback toggle-gamemode();
    callback install-gaming-runtimes();
    callback clear-log();

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // Header
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "⚡ Tweak Gaming & Optimasi Latensi";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-main;
            }
            Text {
                text: "Tingkatkan performa framerate dan kurangi stuttering pada game modern di Linux.";
                font-size: 12px;
                color: Theme.text-sub;
            }
        }

        // Tweak Cards
        VerticalLayout {
            spacing: 14px;

            // 1. CPU Governor Selector
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Profil CPU Governor"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                            Text { text: "Mengontrol frekuensi clock CPU saat beban game berat."; font-size: 11px; color: Theme.text-sub; }
                        }
                        StatusBadge {
                            text: "Aktif: " + root.current-governor;
                            active: true;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        // Performance button
                        Rectangle {
                            height: 32px;
                            background: root.current-governor == "performance" ? Theme.accent : Theme.bg-sidebar;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: "🔥 Performance (Maksimum)";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.current-governor == "performance" ? Theme.text-dark : Theme.text-main;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.set-governor("performance"); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Schedutil button
                        Rectangle {
                            height: 32px;
                            background: root.current-governor == "schedutil" ? Theme.accent : Theme.bg-sidebar;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: "⚖️ Schedutil (Seimbang)";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.current-governor == "schedutil" ? Theme.text-dark : Theme.text-main;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.set-governor("schedutil"); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Powersave button
                        Rectangle {
                            height: 32px;
                            background: root.current-governor == "powersave" ? Theme.accent : Theme.bg-sidebar;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: "🌱 Powersave (Hemat Daya)";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.current-governor == "powersave" ? Theme.text-dark : Theme.text-main;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.set-governor("powersave"); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }

            // 2. vm.max_map_count Tuning
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Memori Game (vm.max_map_count)"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Mencegah crash game Unreal Engine & Steam Proton (Nilai: " + root.max-map-count-value + ")"; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: root.is-max-map-optimized ? Theme.success.with-alpha(0.2) : Theme.accent.with-alpha(0.2);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: root.is-max-map-optimized ? Theme.success : Theme.accent;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.is-max-map-optimized ? "✓ Sudah Optimal (2.1M)" : "Terapkan Tweak (2147483642)";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.is-max-map-optimized ? Theme.success : Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.toggle-max-map-count(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 3. Split Lock Mitigation
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Mitigasi Split Lock (Anti-Stuttering)"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Nonaktifkan penalti split-lock kernel untuk kestabilan FPS game Windows di Proton."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: root.is-split-lock-disabled ? Theme.success.with-alpha(0.2) : Theme.bg-sidebar;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: root.is-split-lock-disabled ? Theme.success : Theme.border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.is-split-lock-disabled ? "✓ Nonaktif (Optimal)" : "Nonaktifkan Mitigasi";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.is-split-lock-disabled ? Theme.success : Theme.text-sub;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.toggle-split-lock(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 4. GameMode Daemon
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Feral GameMode Daemon"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Otomatis mengatur prioritas CPU, I/O, dan GPU saat game diluncurkan."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: root.is-gamemode-active ? Theme.success.with-alpha(0.2) : Theme.bg-sidebar;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: root.is-gamemode-active ? Theme.success : Theme.border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.is-gamemode-active ? "✓ Aktif (Running)" : "Aktifkan Service";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.is-gamemode-active ? Theme.success : Theme.text-sub;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.toggle-gamemode(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 5. One-Click Gaming Toolchain
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "📦 Pasang Ekosistem Gaming Lengkap"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Pasang Wine, Proton-GE, MangoHud, GOverlay, Gamemode, dan Vulkan Tools."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.accent-purple.with-alpha(0.2);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.accent-purple;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Pasang Toolchain Gaming";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.accent-purple;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.install-gaming-runtimes(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }

        // Terminal Log Console
        TerminalBox {
            log-text: root.terminal-log;
            clear-clicked => { root.clear-log(); }
        }
    }
}
