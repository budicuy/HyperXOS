import { Theme } from "../theme.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { TerminalBox } from "../components/terminal_box.slint";

export struct KernelItem {
    name: string,
    package_name: string,
    description: string,
    installed: bool,
    is_running: bool,
    installed_version: string,
}

export component KernelManagerPage inherits Flickable {
    in property <string> running-kernel-name: "linux-cachyos";
    in property <string> running-kernel-ver: "6.12.0-cachyos";
    in property <[KernelItem]> kernels: [];
    in property <string> terminal-log: "Siap.";

    callback install-kernel(string);
    callback remove-kernel(string);
    callback rebuild-initramfs();
    callback clear-log();

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // Header
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "🐧 CachyOS Kernel Manager";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-main;
                }
                Text {
                    text: "Kelola kernel performa tinggi CachyOS dengan patch BORE, SCX, dan compiler v3.";
                    font-size: 12px;
                    color: Theme.text-sub;
                }
            }

            Rectangle {
                height: 32px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    Text {
                        text: "⚙️ Rebuild Initramfs";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.accent-purple;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.rebuild-initramfs(); }
                    mouse-cursor: pointer;
                }
            }
        }

        // Active Booted Kernel Banner
        Rectangle {
            background: Theme.bg-card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.success.with-alpha(0.4);

            HorizontalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "🚀"; font-size: 24px; vertical-alignment: center; }
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Kernel Aktif Saat Ini: " + root.running-kernel-name;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-main;
                        }
                        Text {
                            text: "Versi OS Release: " + root.running-kernel-ver;
                            font-size: 11px;
                            color: Theme.text-sub;
                        }
                    }
                }

                StatusBadge {
                    text: "Aktif Berjalan";
                    active: true;
                    is-running: true;
                }
            }
        }

        // Kernel List
        Text {
            text: "Katalog Kernel Performa & Komunitas:";
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-main;
        }

        VerticalLayout {
            spacing: 10px;

            for item[idx] in root.kernels: Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: item.is-running ? Theme.success.with-alpha(0.5) : Theme.border;

                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: item.name;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-main;
                                vertical-alignment: center;
                            }
                            if item.is-running: StatusBadge {
                                text: "Running";
                                is-running: true;
                            }
                            if item.installed && !item.is-running: StatusBadge {
                                text: "Terpasang";
                                active: true;
                            }
                        }
                        Text {
                            text: item.description;
                            font-size: 11px;
                            color: Theme.text-sub;
                        }
                        if item.installed: Text {
                            text: "Versi Paket: " + item.installed_version;
                            font-size: 10px;
                            color: Theme.accent-purple;
                        }
                    }

                    // Action buttons
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        if !item.installed: Rectangle {
                            height: 30px;
                            background: Theme.accent.with-alpha(0.15);
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Pasang (+Headers)";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.install-kernel(item.package_name); }
                                mouse-cursor: pointer;
                            }
                        }

                        if item.installed && !item.is-running: Rectangle {
                            height: 30px;
                            background: Theme.danger.with-alpha(0.15);
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.danger;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Hapus";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.danger;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.remove-kernel(item.package_name); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }

        // Terminal Log Console
        TerminalBox {
            log-text: root.terminal-log;
            clear-clicked => { root.clear-log(); }
        }
    }
}
