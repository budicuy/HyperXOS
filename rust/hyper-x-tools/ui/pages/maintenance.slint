import { Theme } from "../theme.slint";
import { TerminalBox } from "../components/terminal_box.slint";

export component MaintenancePage inherits Flickable {
    in property <string> terminal-log: "Siap.";

    callback clean-cache();
    callback clean-journal();
    callback remove-orphans();
    callback rank-mirrors();
    callback fix-keyrings();
    callback clear-log();

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // Header
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "🧹 Pemeliharaan & Perawatan Sistem";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-main;
            }
            Text {
                text: "Jaga integritas penyimpanan, bersihkan file sampah dan optimize cermin repositori.";
                font-size: 12px;
                color: Theme.text-sub;
            }
        }

        // Maintenance Action Cards
        VerticalLayout {
            spacing: 12px;

            // 1. Clean Pacman Cache
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Bersihkan Cache Paket Pacman"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Menghapus installer paket lama di /var/cache/pacman/pkg (menyisakan 2 versi terakhir)."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.accent.with-alpha(0.15);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Bersihkan Cache";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.clean-cache(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 2. Vacuum Journal
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Vakum Log Sistem (Systemd Journal)"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Mengompresi dan memangkas ukuran riwayat log sistem hingga di bawah 100 MB."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.accent.with-alpha(0.15);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Vakum Log";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.clean-journal(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 3. Remove Orphans
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Hapus Paket Yatim (Orphan Packages)"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Mencari dan mencopot dependensi yang sudah tidak lagi digunakan oleh aplikasi manapun."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.warning.with-alpha(0.15);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.warning;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Copot Orphans";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.warning;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.remove-orphans(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 4. Rank Mirrors
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Urutkan Cermin Repositori Tercepat"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Menjalankan Reflector untuk menguji unduhan dan memilih mirror pacman tercepat."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.accent-purple.with-alpha(0.15);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.accent-purple;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Uji & Urutkan Mirror";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.accent-purple;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.rank-mirrors(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // 5. Fix Keyrings
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Perbaiki & Sinkronisasi Pacman Keyrings"; font-size: 14px; font-weight: 600; color: Theme.text-main; }
                        Text { text: "Menginisialisasi ulang kunci GPG archlinux, cachyos, dan hyperxos jika ada error signature."; font-size: 11px; color: Theme.text-sub; }
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.accent-teal.with-alpha(0.15);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.accent-teal;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Perbaiki Kunci GPG";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.accent-teal;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.fix-keyrings(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }

        // Terminal Log Console
        TerminalBox {
            log-text: root.terminal-log;
            clear-clicked => { root.clear-log(); }
        }
    }
}
