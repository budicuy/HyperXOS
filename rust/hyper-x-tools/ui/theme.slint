export global Theme {
    // Backgrounds
    out property <color> bg-main: #181825;
    out property <color> bg-sidebar: #11111b;
    out property <color> bg-card: #1e1e2e;
    out property <color> bg-card-hover: #262738;
    out property <color> bg-input: #181825;
    out property <color> bg-terminal: #11111b;

    // Borders
    out property <color> border: #313244;
    out property <color> border-focus: #89b4fa;
    out property <color> border-light: #45475a;

    // Accents
    out property <color> accent: #89b4fa;
    out property <color> accent-hover: #b4befe;
    out property <color> accent-purple: #cba6f7;
    out property <color> accent-teal: #94e2d5;
    out property <color> success: #a6e3a1;
    out property <color> warning: #f9e2af;
    out property <color> danger: #f38ba8;

    // Texts
    out property <color> text-main: #cdd6f4;
    out property <color> text-sub: #a6adc8;
    out property <color> text-muted: #6c7086;
    out property <color> text-dark: #11111b;

    // Sizing
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
}
