# Maintainer: HyperXOS Development Team <dev@hyperxos.org>
pkgname=hyperx-file-manager
pkgver=1.0.0
pkgrel=1
pkgdesc="macOS Finder-style Miller Columns File Browser with Spacebar Quick Look modal overlay (Rust + Iced + WGPU)"
arch=('x86_64')
url="https://github.com/budicuy/HyperXOS"
license=('GPL-3.0-or-later')
depends=('fontconfig' 'freetype2' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'rust')
provides=('hyperx-file-manager' 'hyperx-fm')

build() {
    cd "${startdir}/../../rust/hyperx-de"
    cargo build --release -p hyperx-file-manager
}

package() {
    local target_dir="${startdir}/../../rust/hyperx-de/target/release"

    install -Dm755 "${target_dir}/hyperx-file-manager" "${pkgdir}/usr/bin/hyperx-file-manager"
    install -d "${pkgdir}/usr/local/bin"
    ln -sf /usr/bin/hyperx-file-manager "${pkgdir}/usr/local/bin/hyperx-fm"

    install -Dm644 "${startdir}/hyperx-file-manager.desktop" "${pkgdir}/usr/share/applications/hyperx-file-manager.desktop"
}
