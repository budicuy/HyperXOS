# Maintainer: HyperXOS Development Team <dev@hyperxos.org>
pkgname=hyper-x-tools
pkgver=2.2.0
pkgrel=1
pkgdesc="Modern Glassmorphism System Dashboard, Gaming Tweaker, CachyOS Kernel Manager & Snapshot Center for HyperXOS (Rust + Iced + WGPU)"
arch=('x86_64')
url="https://github.com/budicuy/HyperXOS"
license=('GPL-3.0-or-later')
depends=('fontconfig' 'freetype2' 'libxkbcommon' 'polkit')
makedepends=('cargo' 'rust')
provides=('hyperxtools')

build() {
    cd "${startdir}/../../rust"
    cargo build --release --bin hyper-x-tools --locked
}

package() {
    install -Dm755 "${startdir}/../../rust/target/release/hyper-x-tools" "${pkgdir}/usr/bin/hyper-x-tools"
    install -d "${pkgdir}/usr/local/bin"
    ln -sf /usr/bin/hyper-x-tools "${pkgdir}/usr/local/bin/hyperxtools"
    install -Dm644 "${startdir}/hyper-x-tools.desktop" "${pkgdir}/usr/share/applications/hyper-x-tools.desktop"
    install -Dm644 "${startdir}/logo.png" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/hyper-x-tools.png"
    install -Dm644 "${startdir}/logo.png" "${pkgdir}/usr/share/pixmaps/hyper-x-tools.png"
}
