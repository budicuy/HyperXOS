# Maintainer: HyperXOS Development Team <dev@hyperxos.org>
pkgname=hyper-x-hw
pkgver=1.0.0
pkgrel=1
pkgdesc="Pure Rust Multi-Tier Hardware & GPU Auto-Detection Engine for HyperXOS Linux"
arch=('x86_64')
url="https://github.com/budicuy/HyperXOS"
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('cargo' 'rust')
provides=('hw-detect-gpu')
conflicts=('hw-detect-gpu')
options=('!strip' '!debug')

build() {
    cd "${startdir}/../../rust"
    if [ "${HYPERX_BUILD_MODE}" = "dev" ]; then
        if [ ! -f "target/debug/hyper-x-hw" ]; then
            cargo build --bin hyper-x-hw --locked
        fi
    else
        if [ ! -f "target/release/hyper-x-hw" ]; then
            cargo build --release --bin hyper-x-hw --locked
        fi
    fi
}

package() {
    local target_dir="release"
    if [ "${HYPERX_BUILD_MODE}" = "dev" ]; then
        target_dir="debug"
    fi

    install -Dm755 "${startdir}/../../rust/target/${target_dir}/hyper-x-hw" "${pkgdir}/usr/bin/hyper-x-hw"
    install -d "${pkgdir}/usr/local/bin"
    ln -sf /usr/bin/hyper-x-hw "${pkgdir}/usr/local/bin/hw-detect-gpu"
}
