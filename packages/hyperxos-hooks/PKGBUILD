# Maintainer: HyperXOS Development Team <dev@hyperxos.org>
pkgname=hyperxos-hooks
pkgver=1.0.0
pkgrel=1
pkgdesc="Pacman ALPM hooks for HyperXOS system automation"
arch=('any')
url="https://github.com/budicuy/HyperXOS"
license=('GPL-3.0-or-later')
depends=()

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/share/libalpm/hooks"
    install -m644 hooks/*.hook "${pkgdir}/usr/share/libalpm/hooks/"
}
