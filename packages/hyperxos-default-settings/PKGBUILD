# Maintainer: HyperXOS Development Team <dev@hyperxos.org>
pkgname=hyperxos-default-settings
pkgver=1.0.0
pkgrel=5
pkgdesc="Default shell, user skeleton, and Labwc window manager configuration for HyperXOS"
arch=('any')
url="https://github.com/budicuy/HyperXOS"
license=('GPL-3.0-or-later')
depends=()

package() {
    cd "${startdir}"
    install -d "${pkgdir}/etc/skel"

    if [ -f profile.d/hyperxos.sh ]; then
        install -Dm755 profile.d/hyperxos.sh "${pkgdir}/etc/profile.d/hyperxos.sh"
    fi

    if [ -d etc/xdg/labwc ]; then
        install -d "${pkgdir}/etc/xdg/labwc"
        cp -af etc/xdg/labwc/. "${pkgdir}/etc/xdg/labwc/"
    fi
}
