#!/usr/bin/env bash
# HyperXOS Installer Launcher (Pure Rust Native)
set -eo pipefail

LOG_FILE="/tmp/hyperxos-install.log"
touch "${LOG_FILE}" && chmod 666 "${LOG_FILE}" 2>/dev/null || true
exec > >(tee -a "${LOG_FILE}") 2>&1

echo "==> [HyperXOS] Starting Native Pure Rust System Installer..."
echo "  -> Time: $(date)"
echo "  -> User: $(id -un) (UID $(id -u))"

# Determine installer binary location
INSTALLER_BIN="/usr/bin/hyper-x-installer"
if [ ! -x "${INSTALLER_BIN}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -x "${SCRIPT_DIR}/../../rust/hyper-x-installer/target/release/hyper-x-installer" ]; then
        INSTALLER_BIN="${SCRIPT_DIR}/../../rust/hyper-x-installer/target/release/hyper-x-installer"
    elif [ -x "${SCRIPT_DIR}/target/release/hyper-x-installer" ]; then
        INSTALLER_BIN="${SCRIPT_DIR}/target/release/hyper-x-installer"
    elif [ -x "./rust/hyper-x-installer/target/release/hyper-x-installer" ]; then
        INSTALLER_BIN="./rust/hyper-x-installer/target/release/hyper-x-installer"
    fi
fi

if [ ! -x "${INSTALLER_BIN}" ]; then
    echo "[-] Error: hyper-x-installer binary not found."
    exit 1
fi

# Prevent multiple simultaneous installer instances
if pidof hyper-x-installer >/dev/null 2>&1; then
    echo "==> HyperXOS Installer is already running. Please switch to the active window."
    exit 0
fi

# Allow local root user access to the Xwayland / X11 display server
if command -v xhost >/dev/null 2>&1; then
    xhost +local:root >/dev/null 2>&1 || true
    xhost +SI:localuser:root >/dev/null 2>&1 || true
    xhost + >/dev/null 2>&1 || true
fi

# Ensure display environment variables are exported
export DISPLAY="${DISPLAY:-:0}"
if [ -z "${WAYLAND_DISPLAY}" ]; then
    for s in /run/user/"$(id -u)"/wayland-* /run/user/1000/wayland-*; do
        if [ -e "$s" ] && [[ ! "$s" =~ \.lock$ ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            export XDG_RUNTIME_DIR="$(dirname "$s")"
            break
        fi
    done
fi

if [ "$(id -u)" -eq 0 ]; then
    exec "${INSTALLER_BIN}" "$@"
else
    # In live ISO, hyperxos has NOPASSWD sudo with env_keep
    if sudo -n true 2>/dev/null; then
        exec sudo -E "${INSTALLER_BIN}" "$@"
    elif command -v pkexec >/dev/null 2>&1; then
        exec pkexec env DISPLAY="${DISPLAY}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" "${INSTALLER_BIN}" "$@"
    else
        exec "${INSTALLER_BIN}" "$@"
    fi
fi
