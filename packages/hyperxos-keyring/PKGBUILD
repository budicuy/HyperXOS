# Maintainer: HyperXOS Development Team <dev@hyperxos.org>
pkgname=hyperxos-keyring
pkgver=1.0.0
pkgrel=1
pkgdesc="Official GPG keyring for HyperXOS package verification"
arch=('any')
url="https://github.com/hyperxos"
license=('GPL-3.0-or-later')

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/share/pacman/keyrings"
    install -m644 keyring/hyperxos.gpg "${pkgdir}/usr/share/pacman/keyrings/"
    install -m644 keyring/hyperxos-trusted "${pkgdir}/usr/share/pacman/keyrings/"
    install -m644 keyring/hyperxos-revoked "${pkgdir}/usr/share/pacman/keyrings/"
}
